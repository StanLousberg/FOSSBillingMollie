{
  "name": "stanlousberg/molliepayments",
  "description": "Mollie Payments for FOSSBilling",
  "type": "project",
  "license": "Apache-2.0",
  "keywords": [
    "fossbilling",
    "mollie",
    "payments",
    "gateway",
    "recurring"
  ],
  "homepage": "https://github.com/StanLousberg/FOSSBillingMollie",
  "support": {
    "issues": "https://github.com/StanLousberg/FOSSBillingMollie/issues",
    "source": "https://github.com/StanLousberg/FOSSBillingMollie"
  },
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "mollie/mollie-api-php": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Box\\Mod\\Molliepayments\\": "module/Molliepayments/"
    }
  },
  "config": {
    "vendor-dir": "module/Molliepayments/vendor",
    "sort-packages": true
  }
}
